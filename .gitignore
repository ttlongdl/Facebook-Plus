# ---------------------------------------------------------------------------
# Theos build output
# ---------------------------------------------------------------------------
.theos/
packages/

# ---------------------------------------------------------------------------
# Packaging artifacts (build.sh)
#   - Facebook-Plus.deb : the renamed package build.sh produces
#   - package/          : legacy output directory name, kept ignored for safety
# ---------------------------------------------------------------------------
Facebook-Plus.deb
package/

# ---------------------------------------------------------------------------
# Editor / IDE support
#   compile_commands.json is generated by `make compile-commands`; it holds
#   absolute paths to whoever's theos install built it, so it is per-machine.
#   .clangd and .cache/ are that indexer's local state. .clangd is regenerated
#   from scratch each time `make compile-commands` runs (with this machine's
#   theos path and SDK baked in), so it is per-machine and never committed.
# ---------------------------------------------------------------------------
compile_commands.json
.cache/
.clangd

# ---------------------------------------------------------------------------
# Python tooling (scripts/ and test/ helpers: svg2png.py, etc.)
#   venv/         : virtualenv cairosvg renders from
#   pyrefly.toml  : per-user type-checker config
# ---------------------------------------------------------------------------
venv/
__pycache__/
*.py[cod]
.ruff_cache/
.mypy_cache/
.pytest_cache/
pyrefly.toml
test/*.py

# ---------------------------------------------------------------------------
# Test inputs
#   The decrypted Facebook IPA is copyrighted and machine-local — never commit it.
# ---------------------------------------------------------------------------
test/*
!test/README.md


# ---------------------------------------------------------------------------
# Local-only dev files
#   draft/   : work-in-progress notes and mockups
#   .temp/   : scratch clones
#   .agent/, AGENT.md : AI agent notes
#   preview/ : XcodeGen UI preview harness (dev tool, not part of the build)
# ---------------------------------------------------------------------------
draft/
.temp/
.agent/
AGENT.md
preview/
# ---------------------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------------------
.DS_Store
**/.DS_Store
Thumbs.db
